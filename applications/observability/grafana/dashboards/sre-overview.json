      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(outcome) ((rate(ingestion_accepted_total{service=\"ingestion-api\",env=~\"$env\",instance=~\"$instance\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"ingestion-api\",instance=~\"$instance\"}) < 120)))",
          "refId": "A",
          "legendFormat": "{{outcome}}",
          "range": true,
