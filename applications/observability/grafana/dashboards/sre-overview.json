    {
      "id": 8,
      "type": "timeseries",
      "title": "Aceites novos e duplicatas",
      "description": "Quantidade por segundo de propostas novas aceitas e reenvios reconhecidos como duplicatas. Ajuda a separar demanda nova de tentativas repetidas. Uma duplicata aceita não representa um novo pedido nem deve somar novamente seu valor de negócio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
