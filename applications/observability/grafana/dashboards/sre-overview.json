    {
      "id": 9,
      "type": "timeseries",
      "title": "Profundidade amostrada por lane",
      "description": "Quantidade amostrada de mensagens esperando nas filas fast e standard. Crescimento persistente sugere que o processamento não está acompanhando a entrada. Usa o maior valor entre réplicas que observam a mesma fila para evitar contá-la várias vezes. Não inclui automaticamente propostas ainda na Inbox ou na fila de mensagens com falha (DLQ).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by(lane) (worker_queue_depth{service=\"worker\",env=~\"$env\",instance=~\"$instance\"} and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))",
          "refId": "A",
          "legendFormat": "{{lane}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
