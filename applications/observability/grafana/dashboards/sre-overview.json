            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((rate(business_time_to_settle_seconds_bucket{service=\"worker\",env=~\"$env\",instance=~\"$instance\",le=~\"300|300[.]0\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) / (sum((rate(business_time_to_settle_seconds_count{service=\"worker\",env=~\"$env\",instance=~\"$instance\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) > 0)",
          "refId": "C",
          "legendFormat": "Até 300 s",
          "range": true,
