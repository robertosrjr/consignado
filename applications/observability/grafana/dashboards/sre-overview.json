        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Idade do push mais antigo",
      "description": "Há quantos segundos o serviço com o envio mais antigo deixou de atualizar suas métricas. Valores altos indicam dados desatualizados, não necessariamente queda da aplicação. Os gráficos de aplicação exigem envio com menos de 120 segundos. Esta verificação usa serviço e instância, sem filtro de ambiente; um serviço que nunca enviou métricas pode não aparecer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - min(push_time_seconds{job=~\"ingestion-api|worker|mock-legacy\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "Idade do push mais antigo",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "POSTs por segundo e status",
      "description": "Quantas chamadas de proposta chegam à API por segundo, separadas pelo código da resposta. HTTP 202 indica recebimento; 429 indica limite de requisições; 5xx indica falha no servidor. Use para acompanhar o tráfego gerado pelo JMeter e identificar mudanças nas respostas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(status) ((rate(http_server_requests_seconds_count{service=\"ingestion-api\",env=~\"$env\",instance=~\"$instance\",method=\"POST\",uri=\"/v1/proposals\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"ingestion-api\",instance=~\"$instance\"}) < 120)))",
          "refId": "A",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sem dados",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
