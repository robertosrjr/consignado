        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tempo até decisão — somente finalizados",
      "description": "Entre as propostas que já terminaram, mostra qual percentual levou até 30, 60 ou 300 segundos desde o aceite até a decisão. Propostas ainda pendentes ou presas ficam fora deste gráfico; por isso ele não representa o SLI C da jornada completa. Sem propostas finalizadas, não há percentual.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((rate(business_time_to_settle_seconds_bucket{service=\"worker\",env=~\"$env\",instance=~\"$instance\",le=~\"30|30[.]0\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) / (sum((rate(business_time_to_settle_seconds_count{service=\"worker\",env=~\"$env\",instance=~\"$instance\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) > 0)",
          "refId": "A",
          "legendFormat": "Até 30 s",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((rate(business_time_to_settle_seconds_bucket{service=\"worker\",env=~\"$env\",instance=~\"$instance\",le=~\"60|60[.]0\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) / (sum((rate(business_time_to_settle_seconds_count{service=\"worker\",env=~\"$env\",instance=~\"$instance\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"worker\",instance=~\"$instance\"}) < 120))) > 0)",
          "refId": "B",
          "legendFormat": "Até 60 s",
