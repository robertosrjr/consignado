          },
          "expr": "histogram_quantile(0.99, sum by(le) ((rate(http_server_requests_seconds_bucket{service=\"ingestion-api\",env=~\"$env\",instance=~\"$instance\",method=\"POST\",uri=\"/v1/proposals\"}[$__rate_interval]) and on(instance) ((time() - push_time_seconds{job=\"ingestion-api\",instance=~\"$instance\"}) < 120))))",
          "refId": "A",
          "legendFormat": "Latência p99 do servidor",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
