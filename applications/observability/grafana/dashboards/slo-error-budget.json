{
  "uid": "consignado-slo-budget",
  "title": "Consignado - SLO e Error Budget",
  "description": "SLO v1 (docs/sre/slo.md): budget restante em 30 dias e queima por janela. Metas internas, nao SLA.",
  "tags": [
    "consignado",
    "sre",
    "slo"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "J1 - budget de disponibilidade (30d)",
      "description": "1 - erro/(1-0,995). Verde > 50%, laranja 25-50%, vermelho < 25% (docs/sre/slo.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:j1_availability_budget_remaining:ratio30d",
          "legendFormat": "J1 disponibilidade",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "Sem dado",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "J1 - budget de latencia <= 100 ms (30d)",
      "description": "1 - erro/(1-0,95) sobre aceites 202.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:j1_latency_100ms_budget_remaining:ratio30d",
          "legendFormat": "J1 latencia",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "Sem dado",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
