{
  "uid": "consignado-backlog-drain",
  "title": "Consignado - Backlog e Drenagem",
  "description": "Filas por lane, crescimento liquido, tempo de drenagem e resultado de negocio.",
  "tags": ["consignado","aplicacao","filas"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instancia",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_uptime_seconds, instance)",
          "refId": "v"
        },
        "definition": "label_values(process_uptime_seconds, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Profundidade das filas por lane",
      "description": "worker.queue.depth (amostrada a cada 5 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (lane) (worker_queue_depth{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "{{lane}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chegada vs processamento",
      "description": "worker.arrival.rate e worker.processing.rate (msg/s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(worker_arrival_rate{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "chegada",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(worker_processing_rate{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "processamento",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(net_backlog_growth{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "crescimento liquido",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tempo estimado de drenagem",
      "description": "effective.drain.time = profundidade / taxa de processamento.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(effective_drain_time_seconds{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "drenagem",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Propostas por estado",
      "description": "worker.proposals (estado em memoria do Worker).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (worker_proposals{service=\"worker\",instance=~\"$instance\"})",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processadas por lane e resultado",
      "description": "worker.processed (completed / retry ...) e falhas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (lane, outcome) (rate(worker_processed_total{service=\"worker\",instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{lane}} {{outcome}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (lane) (rate(worker_processing_failed_total{service=\"worker\",instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{lane}} falha",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tempo ate a decisao (somente finalizados)",
      "description": "Fracao dos finalizados em ate 30 s / 1 min / 5 min. Nao inclui propostas presas, nao mede o SLI C e nao comprova averbacao real.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(business_time_to_settle_seconds_bucket{service=\"worker\",instance=~\"$instance\",le=\"30.0\"}[5m])) / (sum(rate(business_time_to_settle_seconds_count{service=\"worker\",instance=~\"$instance\"}[5m])) > 0)",
          "legendFormat": "<= 30 s",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(business_time_to_settle_seconds_bucket{service=\"worker\",instance=~\"$instance\",le=\"60.0\"}[5m])) / (sum(rate(business_time_to_settle_seconds_count{service=\"worker\",instance=~\"$instance\"}[5m])) > 0)",
          "legendFormat": "<= 1 min",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(business_time_to_settle_seconds_bucket{service=\"worker\",instance=~\"$instance\",le=\"300.0\"}[5m])) / (sum(rate(business_time_to_settle_seconds_count{service=\"worker\",instance=~\"$instance\"}[5m])) > 0)",
          "legendFormat": "<= 5 min",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "VGV averbado (R$/s) por resultado",
      "description": "business.vgv por outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(business_vgv_brl_sum{service=\"worker\",instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Primeira passagem",
      "description": "Fracao de averbacoes confirmadas na primeira tentativa.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(business_first_pass_total{service=\"worker\",instance=~\"$instance\",result=\"first_attempt\"}) / (sum(business_first_pass_total{service=\"worker\",instance=~\"$instance\"}) > 0)",
          "legendFormat": "1a passagem",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    }
  ]
}
