# Copie para `.env` (nao versionado) e preencha. Valores vazios sao obrigatorios: o Compose falha
# se estiverem ausentes (sem credenciais padrao). Sugestao de geracao: openssl rand -base64 24

# Perfil padrao do Compose
COMPOSE_PROFILES=infra

# PostgreSQL local (substitui o Aurora)
POSTGRES_DB=consignado
POSTGRES_USER=
POSTGRES_PASSWORD=

# Grafana local
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Emuladores AWS locais (DynamoDB Local, ElasticMQ, local-kms): credenciais FICTICIAS de teste.
# Excecao documentada de ambiente local (SECURITY-12); nunca use credenciais reais aqui.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=sa-east-1
