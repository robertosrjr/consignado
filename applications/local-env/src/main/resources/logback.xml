<?xml version="1.0" encoding="UTF-8"?>
<!-- Sem este arquivo o Logback usa DEBUG: Jetty, Pekko e DynamoDB Local geravam dezenas de MB por minuto
     e deixavam a maquina lenta a ponto de os outros servicos nao subirem no prazo. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="br.com.consignado" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
