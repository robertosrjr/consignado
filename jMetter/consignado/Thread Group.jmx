      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="99 Veredito de idempotencia e negocio" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__groovy((props.getProperty(&quot;storm_threads&quot;\,&quot;0&quot;) as int) &gt; 0 || (props.getProperty(&quot;business_threads&quot;\,&quot;0&quot;) as int) &gt; 0 ? 1 : 0)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
