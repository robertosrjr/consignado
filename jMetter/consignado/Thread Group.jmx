      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Confere novas, duplicatas e valor recebido" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
int storm = props.getProperty(&apos;storm_threads&apos;, &apos;0&apos;) as int
int business = props.getProperty(&apos;business_threads&apos;, &apos;0&apos;) as int
def report = [:]
boolean ok = true
if (storm &gt; 0) {
    int received = props.get(&apos;storm_received&apos;).get()
    int duplicate = props.get(&apos;storm_duplicate&apos;).get()
    report.storm = [received:received, duplicates:duplicate, expectedDuplicates:storm-1]
    ok &amp;= received == 1 &amp;&amp; duplicate == storm-1
}
if (business &gt; 0) {
    int n = props.getProperty(&apos;business_requests&apos;,&apos;10&apos;) as int
    long cents = new BigDecimal(props.getProperty(&apos;business_amount&apos;,&apos;1000.00&apos;)).movePointRight(2).longValueExact() * n
    int received = props.get(&apos;business_received&apos;).get()
    int duplicate = props.get(&apos;business_duplicates&apos;).get()
    long actual = props.get(&apos;business_cents&apos;).get()
    report.business = [received:received, duplicates:duplicate, amountBrl:BigDecimal.valueOf(actual,2), expectedReceived:n, expectedAmountBrl:BigDecimal.valueOf(cents,2), ticketBrl:props.getProperty(&apos;business_amount&apos;,&apos;1000.00&apos;)]
    ok &amp;= received == n &amp;&amp; duplicate == n &amp;&amp; actual == cents
}
String text = JsonOutput.toJson(report)
log.info(&apos;RESULTADO_CONTROLADO &apos; + text)
SampleResult.setResponseData(text, &apos;UTF-8&apos;)
SampleResult.setResponseCode(ok ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(ok ? &apos;Contagens e valores conferem na entrada&apos; : &apos;Divergencia nas contagens ou valores; ver log&apos;)
SampleResult.setSuccessful(ok)
String captureFile = props.getProperty(&apos;sre_summary_file&apos;, &apos;&apos;)
if (captureFile) {
    new File(captureFile).setText(JsonOutput.toJson([schemaVersion:1,attempts:props.get(&apos;sre_attempt_count&apos;).get(),completed:true]), &apos;UTF-8&apos;)
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
