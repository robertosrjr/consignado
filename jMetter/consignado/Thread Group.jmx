<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Consignado - Borda de Absorcao">
      <stringProp name="TestPlan.comments">01 fumaca, 02 carga, 03 duplicatas concorrentes, 04 negocio controlado com replay. Use executar.ps1. 202 nao garante averbacao; conferir finalizacoes no Grafana. Mock atual nao simula rejeicao de negocio.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 Validacao e inicializacao">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Valida parametros e inicia contadores" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">try {
    int tenants = props.getProperty(&apos;tenants&apos;,&apos;20&apos;) as int
    assert tenants &gt;= 0: &apos;tenants nao pode ser negativo&apos;
    boolean active = [&apos;smoke_threads&apos;,&apos;load_threads&apos;,&apos;storm_threads&apos;,&apos;business_threads&apos;].any { (props.getProperty(it, it == &apos;smoke_threads&apos; ? &apos;1&apos; : &apos;0&apos;) as int) &gt; 0 }
    assert !active || tenants &gt; 0: &apos;tenants deve ser positivo ao executar cenarios HTTP&apos;
    for (String name : [&apos;smoke_threads&apos;,&apos;load_threads&apos;,&apos;storm_threads&apos;,&apos;business_threads&apos;]) {
        assert (props.getProperty(name, name == &apos;smoke_threads&apos; ? &apos;1&apos; : &apos;0&apos;) as int) &gt;= 0: name + &apos; nao pode ser negativo&apos;
    }
    assert (props.getProperty(&apos;business_threads&apos;,&apos;0&apos;) as int) &lt;= 1: &apos;negocio usa apenas uma thread&apos;
    int requests = props.getProperty(&apos;business_requests&apos;,&apos;10&apos;) as int
    assert requests &gt; 0: &apos;business_requests deve ser positivo&apos;
    BigDecimal amount = new BigDecimal(props.getProperty(&apos;business_amount&apos;,&apos;1000.00&apos;)).setScale(2)
    assert amount &gt; 0 &amp;&amp; amount &lt; new BigDecimal(&apos;10000000000&apos;): &apos;business_amount fora do contrato&apos;
    Math.multiplyExact(amount.movePointRight(2).longValueExact(), (long) requests)
    assert props.getProperty(&apos;business_convenio&apos;,&apos;INSS&apos;) in [&apos;INSS&apos;,&apos;ESOCIAL_CLT&apos;,&apos;SIAPE_PUBLICO&apos;]: &apos;convenio invalido&apos;
    assert props.getProperty(&apos;business_portability&apos;,&apos;false&apos;) in [&apos;true&apos;,&apos;false&apos;]: &apos;portabilidade invalida&apos;
    props.put(&apos;sre_attempt_count&apos;, new java.util.concurrent.atomic.AtomicLong())
    props.put(&apos;storm_key&apos;, UUID.randomUUID().toString())
    for (String name : [&apos;storm_received&apos;,&apos;storm_duplicate&apos;,&apos;business_received&apos;,&apos;business_duplicates&apos;]) props.put(name, new java.util.concurrent.atomic.AtomicInteger())
    props.put(&apos;business_cents&apos;, new java.util.concurrent.atomic.AtomicLong())
    SampleResult.setResponseCode(&apos;200&apos;)
    SampleResult.setResponseMessage(&apos;Parametros validos&apos;)
    SampleResult.setSuccessful(true)
} catch (Throwable error) {
    SampleResult.setResponseCode(&apos;400&apos;)
    SampleResult.setResponseMessage(error.message ?: &apos;Parametros invalidos&apos;)
    SampleResult.setSuccessful(false)
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
