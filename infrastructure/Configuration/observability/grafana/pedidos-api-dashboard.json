    {
      "type": "timeseries",
      "id": 25,
      "title": "Threads",
      "description": "Threads virtuais no scheduler (mounted = rodando num carrier; queued = aguardando carrier; queued > 0 indica saturação) e threads de plataforma vivas. Threads virtuais estacionadas em I/O não são contadas pela JVM; a concorrência aparece em 'Requisições em andamento'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (scheduling_status) ({__name__=~\"jvm_threads_virtual_live(_threads)?\", job=\"pedidos-api\"})",
          "legendFormat": "Virtuais ({{scheduling_status}})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "max({__name__=~\"jvm_threads_live(_threads)?\", job=\"pedidos-api\"})",
          "legendFormat": "Plataforma",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "sum({__name__=~\"http_server_requests_active(_active_count|_seconds_gcount)\", job=\"pedidos-api\"})",
          "legendFormat": "Requisições em andamento (1 thread virtual cada)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
